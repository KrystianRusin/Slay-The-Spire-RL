# Copy this file to .env and fill in real values. .env is gitignored.
#
# The only environment variable the code reads today. It is loaded by
# python-dotenv in db/session.py and passed straight to SQLAlchemy, so any
# URL SQLAlchemy accepts will work.
#
# Format:
#   postgresql://<username>:<password>@<host>:<port>/<database>
#
# The port is Postgres' default of 5432 unless you changed it.
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/slay_the_spire
