# Copy this file to .env and fill in real values. .env is gitignored.
#
# Loaded by python-dotenv in db/session.py and passed straight to SQLAlchemy,
# so any URL SQLAlchemy accepts will work.
#
# Format:
#   postgresql://<username>:<password>@<host>:<port>/<database>
#
# The port is Postgres' default of 5432 unless you changed it.
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/slay_the_spire

# Comma-separated host:port list of Kafka brokers. Read by broker/config.py.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Replication factor for topics this system creates. 1 suits a single broker.
# KAFKA_REPLICATION_FACTOR=1
